pipeline {
    agent any

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'listo', url: 'https://github.com/anabalisto/todoapp.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'pip install -r requirements.txt'
            }
        }

        stage('Run Python App') {
            steps {
                sh 'python manage.py'
            }
        }
    }
}
